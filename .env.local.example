# MongoDB Atlas Connection String
# Contoh format: mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/lab_sismik?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://admin:password@cluster0.sample.mongodb.net/lab_sismik?retryWrites=true&w=majority

# PIN/Password untuk mengakses halaman Admin Dashboard & Rekap Nilai
# Default: 123456 (bisa diubah sesuai keinginan)
ADMIN_PIN=123456

# Optional NextAuth / App URL jika dideploy
NEXT_PUBLIC_APP_NAME="FINAL LAB SISMIK - Ujian Praktikum"
